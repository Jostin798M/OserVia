# Variables de OserVia publicado. Se configuran en el proyecto de Vercel; no las subas al repositorio.
DJANGO_SECRET_KEY=
DJANGO_PRODUCCION=1
# Dominios propios, separados por comas. Las URL de Vercel se detectan solas.
DJANGO_ALLOWED_HOSTS=

# Supabase > Connect > Transaction pooler (puerto 6543)
DATABASE_URL=postgresql://postgres.REF:CLAVE@aws-0-REGION.pooler.supabase.com:6543/postgres
SUPABASE_URL=https://REF.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=oservia

# Opcional: correo real para recuperar contraseñas
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
